{
  "settings": [
    {
      "default": "85",
      "description": "rotate away at this much of the 5-hour window",
      "enum": [],
      "key": "switch_at",
      "max": 100,
      "min": 0,
      "min_exclusive": true,
      "scopes": [
        "global",
        "profile"
      ],
      "type": "percent"
    },
    {
      "default": "98",
      "description": "...and at this much of the weekly one",
      "enum": [],
      "key": "switch_at_weekly",
      "max": 100,
      "min": 0,
      "min_exclusive": true,
      "scopes": [
        "global",
        "profile"
      ],
      "type": "percent"
    },
    {
      "default": "99",
      "description": "above this, swap mid-turn rather than wait for an idle gap (at or above switch_at)",
      "enum": [],
      "key": "hard_floor",
      "max": 100,
      "min": 0,
      "min_exclusive": true,
      "scopes": [
        "global",
        "profile"
      ],
      "type": "percent"
    },
    {
      "default": "60",
      "description": "poll the account in use every poll_hot above this, rather than poll_active",
      "enum": [],
      "key": "hot_threshold",
      "max": 100,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "percent"
    },
    {
      "default": "idle",
      "description": "\"idle\" to prefer swapping between turns, or \"immediate\"",
      "enum": [
        "idle",
        "immediate"
      ],
      "key": "switch_when",
      "max": null,
      "min": null,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "enum"
    },
    {
      "default": "30s",
      "description": "stop waiting for an idle gap after this",
      "enum": [],
      "key": "max_switch_wait",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "5m0s",
      "description": "hold a rotation this long after a session's last claude.ai call: Claude in Chrome, an artifact, a Doc (0 = off)",
      "enum": [],
      "key": "hold_for_claude_ai",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "45s",
      "description": "after a switch, hold a claude.ai call until this long after it, so it acts as the new account (0 = off)",
      "enum": [],
      "key": "settle_after_swap",
      "max": 300,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "30m0s",
      "description": "give up an account another profile wants when this profile's sessions have been idle this long (0 = never)",
      "enum": [],
      "key": "release_idle_after",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "10m0s",
      "description": "minimum gap between rotations, to stop flapping",
      "enum": [],
      "key": "cooldown",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "3m0s",
      "description": "how often to read the account in use",
      "enum": [],
      "key": "poll_active",
      "max": null,
      "min": 120,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "1m0s",
      "description": "...and when it is near the trigger or burning fast",
      "enum": [],
      "key": "poll_hot",
      "max": null,
      "min": 0,
      "min_exclusive": true,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "10m0s",
      "description": "how often to read the others",
      "enum": [],
      "key": "poll_idle",
      "max": null,
      "min": 120,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
