      "scopes": [
        "global",
        "profile"
      ],
      "type": "number"
    },
    {
      "default": "3",
      "description": "fail over after this many unreadable polls of the account in use (0 = hold)",
      "enum": [],
      "key": "blind_failover_polls",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "int"
    },
    {
      "default": "10",
      "description": "advanced: usage calls per account held back for hot polling",
      "enum": [],
      "key": "hot_reserve",
      "max": 15,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "int"
    },
    {
      "default": "2",
      "description": "advanced: usage calls an hour set aside on a live account for Claude Code's own reads",
      "enum": [],
      "key": "unseen_calls_per_hour",
      "max": 20,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "number"
    },
    {
      "default": "1h0m0s",
