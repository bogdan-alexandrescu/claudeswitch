      "key": "refresh_window",
      "max": null,
      "min": 0,
      "min_exclusive": true,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "24h0m0s",
      "description": "also renew idle accounts this often, to catch a dead refresh token",
      "enum": [],
      "key": "refresh_probe",
      "max": null,
      "min": 0,
      "min_exclusive": false,
      "scopes": [
        "global"
      ],
      "type": "duration"
    },
    {
      "default": "",
