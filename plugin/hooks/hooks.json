{
  "description": "claudeswitch: tell Claude how much quota the active account has left, and which Chrome profile Claude in Chrome needs after a rotation",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__claude-in-chrome__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/chrome-hint.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
